class Solution(object):
    def countSegments(self, s):
        """
        :type s: str
        :rtype: int
        """
        count = 0
        inWord = False  #checking whether we are inside a word

        for ch in s:
            if ch != ' ':  #character is not a space
                if not inWord:
                    count += 1  #starting a new segment
                    inWord = True
            else:
                inWord = False  #word has ended

        return count


print(Solution().countSegments("this is really good."))  
