class Solution(object):
    def reversePrefix(self, word, ch):
        """
        :type word: str
        :type ch: str
        :rtype: str
        """
        chars = list(word)  # converting string into a list
        pos = -1

        for i in range(len(chars)):
            if chars[i] == ch:  # finding the first occurrence of ch
                pos = i
                break

        if pos == -1:
            return word  # character not found

        l = 0
        r = pos

        while l < r:
            chars[l], chars[r] = chars[r], chars[l]  # swapping characters
            l += 1
            r -= 1

        return ''.join(chars)  # converting list back into string

print(Solution().reversePrefix("abcdefd", "d"))  
