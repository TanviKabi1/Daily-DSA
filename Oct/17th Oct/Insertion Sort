class Solution(object):
    def insertionSort(self, nums):
        for i in range(1, len(nums)):

            key = nums[i] # current element to insert
            j = i - 1

            while j >= 0 and nums[j] > key: # shift elements to the right to make space for key
                nums[j + 1] = nums[j]
                j -= 1

            nums[j + 1] = key # put key in correct position

        return nums


print(Solution().insertionSort([5, 3, 4, 1, 2]))