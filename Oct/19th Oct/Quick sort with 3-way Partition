class Solution(object):
    def sortArray(self, nums):
        def quickSort(low, high):
            if low >= high:
                return

            pivot = nums[high] # choose pivot
            lt = low
            i = low
            gt = high

            while i <= gt:
                if nums[i] < pivot:
                    nums[lt], nums[i] = nums[i], nums[lt] # move smaller left
                    lt += 1
                    i += 1
                elif nums[i] > pivot:
                    nums[i], nums[gt] = nums[gt], nums[i] # move larger right
                    gt -= 1
                else:
                    i += 1 # keep equal elements in the middle

            quickSort(low, lt - 1) # sort smaller elements
            quickSort(gt + 1, high) # sort larger elements

        quickSort(0, len(nums) - 1)
        return nums


print(Solution().sortArray([4, 2, 4, 1, 4, 3, 2]))
