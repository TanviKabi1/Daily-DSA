''' lettcode question: Given two strings s and p, 
return an array of all the start indices of p's anagrams in s. 
You may return the answer in any order.
'''
class Solution(object):
    def findAnagrams(self, s, p):
        
        l = 0
        res = []
        window = {}
        freq = {} 

        for ch in p:
            freq[ch] = freq.get(ch, 0) + 1 # creating a frequency dictionary for string p

        for r in range(len(s)):
           
            window[s[r]] = window.get(s[r], 0) + 1  # add the current character to the window

            if r - l + 1 > len(p):     # keep the window size equal to len(p)
                window[s[l]] -= 1

                if window[s[l]] == 0:  # remove the character if its count becomes zero
                    del window[s[l]]

                l += 1

            if window == freq: # check if the current window is an anagram
                res.append(l)

        return res


print(Solution().findAnagrams("cbaebabacd", "abc"))  