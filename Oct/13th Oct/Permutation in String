''' leetcode question: Given two strings s1 and s2, 
return true if s2 contains a permutation of s1, or false otherwise.
In other words, return true if one of s1's permutations is the substring of s2.
'''

class Solution(object):
    def checkInclusion(self, s1, s2):
        """
        :type s1: str
        :type s2: str
        :rtype: bool
        """
        l = 0
        window = {}
        freq = {}

        for ch in s1:
            freq[ch] = freq.get(ch, 0) + 1

        for r in range(len(s2)):
            
            window[s2[r]] = window.get(s2[r], 0) + 1 # add the current character to window

            if r - l + 1 > len(s1): # shrink if window is bigger than s1
                window[s2[l]] -= 1

                if window[s2[l]] == 0: # remove character if count becomes zero
                    del window[s2[l]]

                l += 1

            if window == freq: # check if current window matches s1
                return True

        return False
    
print(Solution().checkInclusion("ab", "eidbaooo"))