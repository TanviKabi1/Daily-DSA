class Solution(object):
    def containsNearbyDuplicate(self, nums, target):
        l = 0
        window = {}

        for r in range(len(nums)):
            if nums[r] in window:
                return True

            window[nums[r]] = 1

            if r - l >= target:
                del window[nums[l]]
                l += 1

        return False


print(Solution().containsNearbyDuplicate([1, 2, 3, 4], 3))