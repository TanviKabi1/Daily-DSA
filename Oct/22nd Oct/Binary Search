class Solution(object):
    def search(self, nums, target):
        low = 0
        high = len(nums) - 1

        while low <= high:
            mid = low + (high - low) // 2 # find middle

            if nums[mid] == target:
                return mid # found target

            if nums[mid] < target:
                low = mid + 1 # search right side
            else:
                high = mid - 1 # search left side

        return -1 
print(Solution().search([-1, 0, 3, 5, 9, 12], 9))