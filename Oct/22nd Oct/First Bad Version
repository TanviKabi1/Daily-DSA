def isBadVersion(version):
    return version >= 4 # versions 4 and above are bad

class Solution(object):
    def firstBadVersion(self, num):
        left = 1
        right = num

        while left < right:
            mid = left + (right - left) // 2 # find middle

            if isBadVersion(mid):
                right = mid # check left side
            else:
                left = mid + 1 # check right side

        return left
print(Solution().firstBadVersion(10))