class Solution(object):
    def sortArray(self, nums):

        if len(nums) <= 1: # already sorted
            return nums

        mid = len(nums) // 2

        left = self.sortArray(nums[:mid]) # split left side
        right = self.sortArray(nums[mid:]) # split right side

        ans = []
        i = j = 0

        while i < len(left) and j < len(right): # compare both sides
            if left[i] <= right[j]:
                ans.append(left[i]) # add smaller element
                i += 1
            else:
                ans.append(right[j]) # add smaller element
                j += 1

        ans += left[i:] # add remaining left elements
        ans += right[j:] # add remaining right elements

        return ans


print(Solution().sortArray([5, 2, 3, 1]))