class Solution(object):
    def merge(self, nums1, nums2):
        ans = []
        i = j = 0

        while i < len(nums1) and j < len(nums2): # compare both arrays
            if nums1[i] <= nums2[j]:
                ans.append(nums1[i]) # add smaller element
                i += 1
            else:
                ans.append(nums2[j]) # add smaller element
                j += 1

        ans += nums1[i:] # add remaining elements
        ans += nums2[j:] # add remaining elements

        return ans


print(Solution().merge([1, 3, 5], [2, 4, 6]))