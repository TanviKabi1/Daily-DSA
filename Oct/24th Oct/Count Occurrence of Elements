class Solution(object):
    def count(self, nums, target):
        left = 0
        right = len(nums) - 1
        first = -1

        while left <= right:
            mid = left + (right - left) // 2 # find middle

            if nums[mid] == target:
                first = mid # found first possible position
                right = mid - 1 # check left side
            elif nums[mid] < target:
                left = mid + 1 # move right
            else:
                right = mid - 1 # move left

        if first == -1:
            return 0 # target not found

        left = 0
        right = len(nums) - 1
        last = -1

        while left <= right:
            mid = left + (right - left) // 2 # find middle

            if nums[mid] == target:
                last = mid # found last possible position
                left = mid + 1 # check right side
            elif nums[mid] < target:
                left = mid + 1 # move right
            else:
                right = mid - 1 # move left

        return last - first + 1
print(Solution().count([1, 2, 2, 2, 3, 4], 2))
