class Solution(object):
    def searchRange(self, nums, target):
        first = -1
        last = -1

        left = 0
        right = len(nums) - 1

        while left <= right:
            mid = left + (right - left) // 2 # find middle

            if nums[mid] == target:
                first = mid # store first possible position
                right = mid - 1 # check further left
            elif nums[mid] < target:
                left = mid + 1 # move right
            else:
                right = mid - 1 # move left

        left = 0
        right = len(nums) - 1

        while left <= right:
            mid = left + (right - left) // 2 # find middle

            if nums[mid] == target:
                last = mid # store last possible position
                left = mid + 1 # check further right
            elif nums[mid] < target:
                left = mid + 1 # move right
            else:
                right = mid - 1 # move left

        return [first, last]
print(Solution().searchRange([5, 7, 7, 8, 8, 10], 8))
