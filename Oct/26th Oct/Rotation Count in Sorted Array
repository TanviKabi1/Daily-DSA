class Solution(object):
    def rotationCount(self, nums):
        left = 0
        right = len(nums) - 1

        while left < right:
            mid = left + (right - left) // 2 # find middle

            if nums[mid] > nums[right]:
                left = mid + 1 # minimum is on right
            else:
                right = mid # minimum is here or left

        return left # index of minimum = rotation count
print(Solution().rotationCount([4, 5, 6, 7, 0, 1, 2]))