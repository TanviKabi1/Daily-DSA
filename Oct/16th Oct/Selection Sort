class Solution(object):
    def selectionSort(self, nums):
        n = len(nums)

        for i in range(n):

            small = i  # assume current position has smallest

            for j in range(i + 1, n):

                if nums[j] < nums[small]:  # find smaller element
                    small = j

            nums[i], nums[small] = nums[small], nums[i]   # swap smallest with current

        return nums


print(Solution().selectionSort([5, 3, 8, 1, 2]))