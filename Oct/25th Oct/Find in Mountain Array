class Solution(object):
    def findInMountainArray(self, target, arr):
        left = 0
        right = len(arr) - 1

        while left < right:
            mid = left + (right - left) // 2 # find peak

            if arr[mid] < arr[mid + 1]:
                left = mid + 1 # peak is on right
            else:
                right = mid # peak is here or left

        peak = left

        left = 0
        right = peak

        while left <= right:
            mid = left + (right - left) // 2 # search increasing side

            if arr[mid] == target:
                return mid

            if arr[mid] < target:
                left = mid + 1 # move right
            else:
                right = mid - 1 # move left

        left = peak + 1
        right = len(arr) - 1

        while left <= right:
            mid = left + (right - left) // 2 # search decreasing side

            if arr[mid] == target:
                return mid

            if arr[mid] > target:
                left = mid + 1 # move right
            else:
                right = mid - 1 # move left

        return -1 # target not found