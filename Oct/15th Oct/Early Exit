class Solution(object):
    def bubbleSort(self, nums):
        n = len(nums)

        for i in range(n):
            swapped = False # flag to check if any swap occurred

            for j in range(n - i - 1):

                if nums[j] > nums[j + 1]: # swap if the current element is greater than the next element
                    nums[j], nums[j + 1] = nums[j + 1], nums[j]
                    swapped = True

            if swapped == False: # if no two elements were swapped by inner loop, then break
                break

        return nums


print(Solution().bubbleSort([1, 2, 3, 4, 5]))