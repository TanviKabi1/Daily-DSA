class Solution(object):
    def bubbleSort(self, nums):
        n = len(nums)

        for i in range(n):
            for j in range(n - i - 1):

                if nums[j] > nums[j + 1]: # swap if the current element is greater than the next element
                    nums[j], nums[j + 1] = nums[j + 1], nums[j]

        return nums


print(Solution().bubbleSort([5, 2, 8, 1, 3]))